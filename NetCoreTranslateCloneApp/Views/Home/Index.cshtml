<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <form method="post" action="@Url.Action("Translate")" class="bg-white shadow-sm rounded-3 p-4">

                <h3 class="mb-4 text-center">Metin Çeviri Aracı</h3>

                <div class="mb-3">
                    <label for="query" class="form-label">Çevirmek istediğiniz metni girin:</label>
                    <textarea class="form-control" name="query" id="query" placeholder="Metni buraya yazın..." rows="4" required
                              oninvalid="this.setCustomValidity('Lütfen bu alanı doldurunuz')"
                              oninput="this.setCustomValidity('')"></textarea>
                </div>

                <div class="mb-3">
                    <label for="selectedLanguage" class="form-label">Dil Seçin:</label>
                    <select name="selectedLanguage" id="selectedLanguage" class="form-select" required
                            oninvalid="this.setCustomValidity('Lütfen bir dil seçin')"
                            oninput="this.setCustomValidity('')">
                        <option value="" selected disabled>Bir dil seçin</option>
                        @foreach (var language in ViewBag.Languages)
                        {
                            <option value="@language.Text">@language.Text</option>
                        }
                    </select>

                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg d-flex align-items-center justify-content-center gap-2">
                        Çevir
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-translate" viewBox="0 0 16 16">
                            <path d="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286H4.545zm1.634-.736L5.5 3.956h-.049l-.679 2.022H6.18z" />
                            <path d="M0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2zm7.138 9.995c.193.301.402.583.63.846-.748.575-1.673 1.001-2.768 1.292.178.217.451.635.555.867 1.125-.359 2.08-.844 2.886-1.494.777.665 1.739 1.165 2.93 1.472.133-.254.414-.673.629-.89-1.125-.253-2.057-.694-2.82-1.284.681-.747 1.222-1.651 1.621-2.757H14V8h-3v1.047h.765c-.318.844-.74 1.546-1.272 2.13a6.066 6.066 0 0 1-.415-.492 1.988 1.988 0 0 1-.94.31z" />
                        </svg>
                    </button>
                </div>
            </form>

            @if (ViewBag.Result != null)
            {
                <div class="mt-4">
                    <h5 class="mb-2">Sonuç:</h5>
                    <div class="alert alert-info p-3">@Html.Raw(ViewBag.Result)</div>
                </div>
            }

        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(135deg, #f0f4f8, #d9e2ec);
        font-family: 'Inter', sans-serif;
    }

    textarea:focus, select:focus {
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 85, 0.25);
        border-color: #28a745;
    }

    .btn-success svg {
        transition: transform 0.2s ease;
    }

    .btn-success:hover svg {
        transform: translateX(3px);
    }
</style>
